<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:elevation="1dp"
    android:layout_marginBottom="10dp">

    <!-- Top row: Shortcut badge, Category, and Air-Gapped status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvVaultShortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="myaddr"
            android:textColor="#7C3AED"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="#EDE9FE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/tvVaultCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="#475569"
            android:textSize="12sp"
            android:background="#F1F5F9"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvAirGapBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Air-Gapped"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:background="#FEE2E2"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Phrase preview (Masked or Plaintext) -->
    <TextView
        android:id="@+id/tvVaultPhrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="123••••NY"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMoveToNormal"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🌐 Move to Normal"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:background="#EFF6FF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnVaultEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Edit"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:background="#E2E8F0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnVaultDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Delete"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:background="#FEE2E2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>
</LinearLayout>
