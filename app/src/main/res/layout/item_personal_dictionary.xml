<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:elevation="1dp"
    android:layout_marginBottom="10dp">

    <!-- Top row: Shortcut badge and weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvShortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="omw"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="#DBEAFE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/tvWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight: 250"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMirrorBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ System Mirrored"
            android:textColor="#059669"
            android:textSize="11sp"
            android:background="#D1FAE5"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Phrase text -->
    <TextView
        android:id="@+id/tvPhrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="On my way!"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMoveToVault"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🛡️ Move to Privacy Vault"
            android:textColor="#7C3AED"
            android:textSize="12sp"
            android:background="#EDE9FE"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Edit"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:background="#E2E8F0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Delete"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:background="#FEE2E2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>
</LinearLayout>
